# Firebase public web configuration (optional overrides).
# Leave blank to use the existing AG Home project configured in firebase-config.js.
# VITE_* values are visible in the built website; never use backend credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional Web Push certificate from Firebase Console; blank disables push enrollment.
VITE_FIREBASE_VAPID_KEY=

# App Configuration
VITE_ADMIN_EMAIL=
VITE_ENVIRONMENT=production
VITE_FIREBASE_SERVICE_WORKER_PATH=/AG-Home/firebase-messaging-sw.js

# Firebase Functions (Optional - for emulator)
VITE_FUNCTIONS_REGION=us-central1
VITE_FUNCTIONS_EMULATOR_HOST=localhost
VITE_FUNCTIONS_EMULATOR_PORT=5001
# Local emulators only; never enable in a production build.
VITE_USE_EMULATORS=false
# Enable only after upgrading Firebase Auth to Identity Platform and enabling TOTP.
VITE_ENABLE_TOTP_MFA=false
