# Cloud Functions Environment Variables
# Copy this file to functions/.env.local and fill in your values

# Admin emails (comma-separated if multiple)
ADMIN_EMAIL=ag.aliengamerz@gmail.com
ALLOWED_ADMIN_EMAILS=ag.aliengamerz@gmail.com,hamza.datashare@gmail.com

# Environment
ENVIRONMENT=development

# Firebase project Web API Key for password verification in private username sign-in.
# Configure API restrictions to allow Identity Toolkit from the deployed backend.
FIREBASE_WEB_API_KEY=

# HTTP compatibility endpoints: exact allowed origins, comma-separated.
ALLOWED_ORIGINS=https://ag-alien-gamerz.github.io,https://ag-pixel-creater.github.io,http://localhost:5173,http://127.0.0.1:5173
